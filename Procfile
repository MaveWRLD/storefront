web: python manage.py collectstatic --noinput && export OTEL_TRACES_SAMPLER=${OTEL_TRACES_SAMPLER:-parentbased_traceidratio} OTEL_TRACES_SAMPLER_ARG=${OTEL_TRACES_SAMPLER_ARG:-0.2} OTEL_EXPORTER_OTLP_COMPRESSION=${OTEL_EXPORTER_OTLP_COMPRESSION:-gzip} OTEL_METRIC_EXPORT_INTERVAL=${OTEL_METRIC_EXPORT_INTERVAL:-300000} OTEL_PYTHON_DISABLED_INSTRUMENTATIONS=${OTEL_PYTHON_DISABLED_INSTRUMENTATIONS:-system_metrics} && exec ${OTEL_EXPORTER_OTLP_ENDPOINT:+opentelemetry-instrument} gunicorn storefront.wsgi --bind 0.0.0.0:$PORT --workers 3 --threads 2 --worker-class gthread --timeout 60 --access-logfile - --error-logfile -
